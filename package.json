{
  "name": "subscription-ledger",
  "version": "1.0.0",
  "private": true,
  "description": "私人订阅账本：Next.js + SQLite，人民币，手动记账",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "next dev -p 8765",
    "build": "python3 scripts/package-skill.py && next build && node scripts/build-worker.mjs",
    "start": "next start -p 8765",
    "serve": "node .next/standalone/server.js",
    "test": "vitest run",
    "smoke": "tsx scripts/http_smoke.mts",
    "init-password": "tsx src/server/cli/init-password.ts",
    "worker": "tsx src/server/worker.ts",
    "migrate": "tsx src/server/cli/maintenance.ts migrate",
    "backup-db": "tsx src/server/cli/maintenance.ts backup"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "postcss": "^8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "^7.0.2",
    "vitest": "5.0.0"
  }
}
